  "defaultTemplates": {
    "Cadence/Templates/contact.md": "---\nname: {{name}}\nemail: []\nphone: []\ncompany: []\nrole: []\nproject:\nlastContact:\ntags: []\ntype: contact\n---\n\n# {{name}}\n\n\n## Bio #notes\n_Background, interests, and how we met..._\n\n## Tasks #tasks\n- [ ] Follow up in 2 weeks\n",
    "Cadence/Templates/company.md": "---\nname: {{name}}\ndomain: []\nindustry: []\nsize:\nowner:\ntags: []\ntype: company\n---\n\n# {{name}}\n\n\n## Description #notes\n_Company description and profile..._\n\n## Contacts #cross-contact-company-table\n\n## Deals #cross-deal-company-kanban\n",
    "Cadence/Templates/partner.md": "---\nname: {{name}}\ntier:\nstatus:\nowner:\nregion:\ntype: partner\n---\n\n# {{name}}\n\n\n## Notes #notes\n_Context and general notes..._\n",
    "Cadence/Templates/registration.md": "---\ntitle: {{name}}\npartner:\nstatus:\nvalue: 0\nsubmitted:\nexpires:\ntype: registration\n---\n\n# {{name}}\n\n\n## Notes #notes\n_Context and general notes..._\n",
    "Cadence/Templates/commission.md": "---\nreference: {{name}}\npartner:\namount: 0\nstatus:\nperiod:\npaidOn:\ntype: commission\n---\n\n# {{name}}\n\n\n## Notes #notes\n_Context and general notes..._\n",
    "Cadence/Templates/lead.md": "---\nname: {{name}}\ncompany:\nsource:\nstatus:\nassigned:\ntype: lead\n---\n\n# {{name}}\n\n\n## Notes #notes\n_Context and general notes..._\n",
    "Cadence/Templates/certification.md": "---\nname: {{name}}\npartner:\nlevel:\nissued:\nexpires:\ntype: certification\n---\n\n# {{name}}\n\n\n## Notes #notes\n_Context and general notes..._\n",
    "Cadence/Templates/activity.md": "---\nsubject: {{name}}\ntype:\nwhen:\nwith:\ncompany:\nproject:\n---\n\n# {{name}}\n\n\n## Notes #notes\n_Context and general notes..._\n",
    "Cadence/Templates/sequence.md": "---\nname: {{name}}\naudience:\nsteps: 0\nactive: 0\nstatus:\ntype: sequence\n---\n\n# {{name}}\n\n\n## Notes #notes\n_Context and general notes..._\n",
    "Cadence/Templates/project.md": "---\ntype: project\nname: {{name}}\nstatus: [active]\npriority: [medium]\nowner: []\nstarted: 2026-01-15\ndue:\ntags: []\nrelated_deals: []\nrelated_partners: []\n---\n\n# {{name}}\n\n## Brief\n_The outcome we want, why now._\n\n\n## Scope\n**In scope:**\n- \n\n**Out of scope:**\n- \n\n## Milestones\n- [ ] 2026-01-15 — First milestone\n\n## Tasks\n- [ ] \n\n## Risks\n- \n\n## Stakeholders\n- \n\n## Notes\n\n",
    "Cadence/Templates/deal.md": "---\ntitle: {{name}}\nstage: [Lead]\nvalue: 0\ncompany:\ncontact:\ncloseBy:\nproject:\nowner:\ntype: deal\n---\n\n# {{name}}\n\n\n## Notes #notes\n_Context and general notes..._\n",
    "Cadence/Templates/daily.md": "# {{date}}\n\n## Today\n- [ ] \n\n## Journal\n\n"
  },
